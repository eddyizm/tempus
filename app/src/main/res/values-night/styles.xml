        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_dark_primaryInverse</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:scrollbars">none</item>

        <item name="floatingActionButtonStyle">@style/FloatingActionButtonStyle</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.App.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/Widget.App.Snackbar.Button</item>
    </style>

    <style name="AppTheme.Amoled.SurfacesOnly" parent="">
        <!-- Regular surface overriding -->
        <item name="colorSurface">@color/md_theme_amoled_surface_override</item>
        <item name="colorSurfaceVariant">@color/md_theme_amoled_surface_override</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_amoled_surface_override</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_amoled_surface_override</item>
        <item name="colorSurfaceContainer">@color/md_theme_amoled_surface_override</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_amoled_surface_override</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_amoled_surface_override</item>
        <item name="colorOutline">@color/md_theme_amoled_surface_override</item>
        <item name="colorOutlineVariant">@color/md_theme_amoled_surface_override</item>

        <!-- Extended surface overriding -->
        <item name="materialSwitchStyle">@style/Widget.App.MaterialSwitch.Amoled</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Amoled</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog.Amoled</item>
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet.Amoled</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView.Amoled</item>
        <item name="android:dialogTheme">@style/ThemeOverlay.App.Dialog.Amoled</item>
        <item name="dialogTheme">@style/ThemeOverlay.App.Dialog.Amoled</item>

        <item name="android:colorBackground">@color/md_theme_amoled_surface_override</item>
        <item name="android:windowBackground">@color/md_theme_amoled_surface_override</item>
        <item name="android:scrollbars">none</item>

        <!-- For API 24 to API 29-ish -->
        <item name="android:statusBarColor">@color/md_theme_amoled_surface_override</item>
        <item name="android:navigationBarColor">@color/md_theme_amoled_surface_override</item>
        <item name="android:navigationBarDividerColor" tools:targetApi="27">@color/md_theme_amoled_surface_override</item>

        <!-- Prevent black-over-black text -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog.Amoled" parent="ThemeOverlay.Material3.BottomSheetDialog">
