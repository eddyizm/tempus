<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Theme dropdown menu -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/themesListContainer"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mainSwitchesContainer"
        app:layout_constraintTop_toTopOf="parent">

        <AutoCompleteTextView
            android:id="@+id/themesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:focusable="true"
            android:clickable="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/mainSwitchesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/themesListContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/trueBlackSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/la_theme_switch_true_black"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/defaultDynamicSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/la_theme_switch_default_dynamic"/>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/chooseAccentColorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/mainSwitchesContainer"
        app:layout_constraintBottom_toBottomOf="@id/parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/chooseAccentColorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/la_theme_title"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/la_theme_description"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="4"
            android:rowCount="2"
            android:useDefaultMargins="true">

            <!-- Option 1: Flirt Red (#B5076B) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_flirt"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:contentDescription="@string/la_theme_card_flirt_red_description"
                app:cardCornerRadius="16dp" >

            </com.google.android.material.card.MaterialCardView>

            <!-- Option 2: Vibrant Coral/Red (#FF5722) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_coral"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FF5722"
                android:contentDescription="@string/la_theme_card_coral_red_description"
                app:cardCornerRadius="16dp" />

            <!-- Option 3: Emerald Green (#2E7D32) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_emerald"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#2E7D32"
                android:contentDescription="@string/la_theme_card_royal_blue_description"
                app:cardCornerRadius="16dp" />

            <!-- Option 4: Royal Blue (#1976D2) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_blue"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#1976D2"
                android:contentDescription="@string/la_theme_card_royal_blue_description"
                app:cardCornerRadius="16dp" />

            <!-- Option 5: Purple/Violet (#7B1FA2) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_purple"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#7B1FA2"
                android:contentDescription="@string/la_theme_card_purple_violet_description"
                app:cardCornerRadius="16dp" />

            <!-- Option 6: Sunset Amber (#FFA000) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_amber"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFA000"
                android:contentDescription="@string/la_theme_card_sunset_amber_description"
                app:cardCornerRadius="16dp" />

            <!-- Option 7: Teal (#00796B) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_teal"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#00796B"
                android:contentDescription="@string/la_theme_card_teal_description"
                app:cardCornerRadius="16dp" />

            <!-- Option 8: Slate Gray (#455A64) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_slate"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#455A64"
                android:contentDescription="@string/la_theme_card_slate_gray_description"
                app:cardCornerRadius="16dp" />

        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>